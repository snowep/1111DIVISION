# Copy this file to .env and fill in your key.
# .env is gitignored — never commit it.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Primary model. NIM defaults to llama-3.1-8b-instruct.
NIM_MODEL=openai/gpt-oss-20b

# Auto-routing: if the primary model is unavailable (404 / network fail),
# the bridge retries the SAME request on each fallback model in order.
# Use REAL model IDs that actually serve chat/completions on your key.
NIM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4-flash-0731,z-ai/glm-5.3-flash,meta/llama-3.2-11b-vision-instruct

# Set to "off" to disable auto-routing (primary only).
NIM_ROUTER=auto

PORT=3001