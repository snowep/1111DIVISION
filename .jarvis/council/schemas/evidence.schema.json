{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "Atomic knowledge unit. Every claim in a council meeting traces to evidence. Companion to api-schema.md Schema 1.",
  "type": "object",
  "required": [
    "id", "meeting_id", "description", "type", "source", "source_type",
    "confidence", "verified", "phase", "registered_by", "registered_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^EVD-\\d+$", "description": "Scoped to meeting: EVD-001" },
    "meeting_id": { "type": "string", "pattern": "^MEETING-\\d{8}-\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "user-testimony", "direct-observation", "project-artifact",
        "research-synthesis", "external-article", "web-search",
        "historical", "inference", "council-vm"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["file", "inference", "persona", "web", "meeting", "memory", "user", "tool"]
    },
    "source_ref": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Set at registration; immutable" },
    "verified": { "type": "boolean" },
    "based_on": { "type": "array", "items": { "type": "string", "pattern": "^EVD-\\d+$" }, "description": "Required if type=inference" },
    "phase": { "type": "string", "enum": ["pre-meeting", "in-meeting"] },
    "registered_by": { "type": "string", "description": "jarvis for Phase 1, persona.<id> for Phase 2" },
    "registered_at": { "type": "string", "format": "date-time" },
    "cited_by": { "type": "array", "items": { "type": "string" }, "description": "Position IDs that cite this evidence" },
    "supports": { "type": "array", "items": { "type": "string" }, "description": "Resolution option IDs this evidence supports" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "inference" } } },
      "then": {
        "required": ["based_on"],
        "properties": { "based_on": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "council-vm" } } },
      "then": {
        "properties": { "phase": { "const": "in-meeting" } },
        "required": ["registered_by"]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "pre-meeting" } } },
      "then": { "properties": { "registered_by": { "const": "jarvis" } } }
    },
    {
      "if": { "properties": { "phase": { "const": "in-meeting" } } },
      "then": { "properties": { "registered_by": { "pattern": "^persona\\.[a-z0-9-]+$" } } }
    }
  ]
}