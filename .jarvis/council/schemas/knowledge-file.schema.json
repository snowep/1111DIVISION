{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://schemas/knowledge-file.schema.json",
  "title": "KnowledgeFile",
  "description": "Vault document with lineage. The project's curated knowledge layer. Companion to api-schema.md Schema 9.",
  "type": "object",
  "required": [
    "id", "path", "filename", "type", "content_type",
    "title", "description", "tags", "created_at", "updated_at", "author",
    "content", "content_hash", "version"
  ],
  "properties": {
    "id": { "type": "string", "description": "Auto-generated UUID or path-based ID" },
    "path": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["decision", "methodology", "research", "guide", "log", "meeting-summary", "persona", "template"]
    },
    "content_type": { "type": "string", "enum": ["markdown", "yaml", "json", "text"] },

    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "author": { "type": "string", "enum": ["jarvis", "user", "council", "external"] },

    "content": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of content" },

    "source_meeting_id": { "type": ["string", "null"] },
    "source_decision_id": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 },
    "related_files": { "type": "array", "items": { "type": "string" } },
    "referenced_by": { "type": "array", "items": { "type": "string" } }
  }
}