{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://schemas/decision.schema.json",
  "title": "Decision",
  "description": "Lifecycle from council recommendation to active decision. Companion to api-schema.md Schema 8.",
  "type": "object",
  "required": [
    "id", "question", "recommendation_id", "meeting_id",
    "decision", "rationale", "status", "created_at",
    "confidence", "confidence_label", "evidence_ids", "reversal_conditions",
    "source_meeting_id"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^DEC-\\d+$" },
    "question": { "type": "string", "minLength": 3 },
    "recommendation_id": { "type": "string", "pattern": "^council-recommendation-.*$" },
    "meeting_id": { "type": "string", "pattern": "^MEETING-\\d{8}-\\d+$" },
    "decision": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },

    "status": { "type": "string", "enum": ["candidate", "active", "superseded", "deprecated"] },
    "authority": { "type": "string", "enum": ["user-explicit", "decision-rule"] },
    "authority_source": { "type": "string" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },

    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Inherited from source meeting, not recomputed" },
    "confidence_label": { "type": "string", "enum": ["VERY HIGH", "HIGH", "MEDIUM", "LOW", "VERY LOW"] },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "reversal_conditions": { "type": "array", "items": { "type": "object" } },

    "created_at": { "type": "string", "format": "date-time" },
    "superseded_by": { "type": ["string", "null"] },
    "superseded_at": { "type": ["string", "null"], "format": "date-time" },
    "source_meeting_id": { "type": "string" },
    "vault_path": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "oneOf": [
              { "const": "active" },
              { "const": "superseded" },
              { "const": "deprecated" }
            ]
          }
        }
      },
      "then": {
        "required": ["authority", "approved_by", "approved_at"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } } },
      "then": { "required": ["superseded_by"] }
    }
  ]
}